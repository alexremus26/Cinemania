<header class="main-header">
    <div class="logo-area">
        <img src="/resurse/imagini/CinemaniaLogo.png" id="Logo" alt="Cinemania Logo" />
        <h1 id="title">Cinemania</h1>
    </div>
    <nav class="site-nav" aria-label="Navigare principala">
        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Deschide meniul" />
        <label for="menu-toggle" class="burger-btn" aria-label="Meniu">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <ul class="nav-main">
            <li class="mobile-home-only">
                <a href="/" aria-label="Acasa">
                    <i class="fa-solid fa-house"></i>
                    <span class="nav-text">Acasa</span>
                </a>
            </li>

            <li class="has-dropdown">
                <a href="/" aria-label="Acasa">
                    <i class="fa-solid fa-house"></i>
                    <span class="nav-text">Acasa</span>
                </a>
                <ul class="dropdown submenu-sections">
                    <li><a href="#orar">Program Curent</a></li>
                    <li><a href="#welcome">Galerie</a></li>
                    <li><a href="#upcoming">Trailere Noi</a></li>
                    <li><a href="#facilitati">Tehnologii</a></li>
                </ul>
            </li>

            <li class="has-dropdown">
                <a href="/filme" aria-label="Filme">
                    <i class="fa-solid fa-film"></i>
                    <span class="nav-text">Filme</span>
                </a>
                <ul class="dropdown submenu-sections">
                    <li><a href="/filme">Toate</a></li>
                    <% if (locals.categorii && categorii.length > 0) { %>
                        <% categorii.forEach(function(categ) { %>
                            <li><a href="/filme?tip=<%= categ %>"><%= categ.charAt(0).toUpperCase() + categ.slice(1) %></a></li>
                        <% }) %>
                    <% } %>
                </ul>
            </li>

            <li>
                <a href="/galerie" aria-label="Galerie Foto">
                    <i class="fa-solid fa-images"></i>
                    <span class="nav-text">Galerie</span>
                </a>
            </li>

            <li>
                <a href="/locatii" aria-label="Cinematografe">
                    <i class="fa-solid fa-location-dot"></i>
                    <span class="nav-text">Locatii</span>
                </a>
            </li>

            <li>
                <a href="/bilete" aria-label="Bilete si servicii">
                    <i class="fa-solid fa-ticket"></i>
                    <span class="nav-text">Bilete</span>
                </a>
            </li>

            <li>
                <a href="/contul-meu" aria-label="Contul meu">
                    <i class="fa-solid fa-user"></i>
                    <span class="nav-text">Contul Meu</span>
                </a>
            </li>
            <!-- CERINȚA E: SWITCH BOOTSTRAP PENTRU SCHIMBAREA TEMEI -->
            <li class="d-flex align-items-center ps-4 ps-lg-5" style="min-height: 40px;">
                <div class="form-check form-switch p-0 m-0 d-flex align-items-center gap-2">
                    <input class="form-check-input" type="checkbox" id="theme-toggle" role="switch" style="cursor: pointer; width: 2.2em; height: 1.1em; margin-top: 0;" aria-label="Schimbă tema">
                    <label class="form-check-label" for="theme-toggle" style="cursor: pointer; line-height: 1;">
                        <i id="theme-icon" class="fa-solid fa-moon text-light" style="font-size: 1.1rem; transition: all 0.3s ease;"></i>
                    </label>
                </div>
            </li>
        </ul>
    </nav>
</header>